{
  "name": "homestat",
  "version": "0.1.1",
  "description": "Terminal homepage dashboard for self-hosted services.",
  "keywords": [
    "terminal",
    "dashboard",
    "self-hosted",
    "monitoring"
  ],
  "homepage": "https://github.com/tibebez/homestat#readme",
  "bugs": {
    "url": "https://github.com/tibebez/homestat/issues"
  },
  "license": "MIT",
  "author": "Tibebe",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tibebez/homestat.git"
  },
  "files": [
    "dist",
    "bin"
  ],
  "bin": {
    "homestat": "./bin/homestat.mjs"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run build:lib && bun run build:cli",
    "build:lib": "bun build src/index.ts --outfile dist/index.mjs --format esm",
    "build:cli": "bun build src/cli.ts --outdir dist --format esm --target node",
    "dev": "bun build src/index.ts --outfile dist/index.mjs --format esm --watch",
    "dashboard": "bun run src/cli.ts",
    "test": "bun test",
    "check": "bunx tsc --noEmit",
    "prepublishOnly": "bun run check && bun run test && bun run build"
  },
  "dependencies": {
    "@opentui/core": "^0.2.0",
    "open": "^11.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^25.5.0",
    "@typescript/native-preview": "7.0.0-dev.20260328.1",
    "bumpp": "^11.0.1",
    "typescript": "^6.0.2"
  },
  "packageManager": "bun@1.3.13"
}
